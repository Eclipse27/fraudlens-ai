# FraudLens AI - Backend Environment Template
# Note: For local development, all variables are optional.
# The backend automatically defaults to local JSON storage (data/synthetic_database.json).

# AWS Configuration (Used when running in AWS or using AWS DynamoDB)
AWS_REGION=ap-south-1
DYNAMODB_TABLE_NAME=FraudInvestigationHistory

# Optional: Set DynamoDB Local endpoint if using a local Docker container
# DYNAMODB_ENDPOINT_URL=http://localhost:8000

# Frontend Origin for CORS configuration
FRONTEND_ORIGIN=http://localhost:5173
